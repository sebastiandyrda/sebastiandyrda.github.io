@article{DyrdaPugsleyEJ2024,
    author  = {Dyrda, Sebastian and Pugsley, Benjamin},
    title   = "{The Rise of Pass-Throughs: an Empirical Investigation}",
    journal = {The Economic Journal},
    pages   = {ueae062},
    year    = {2024},
    month   = {07},
    issn    = {0013-0133},
    doi     = {10.1093/ej/ueae062},
    url     = {https://doi.org/10.1093/ej/ueae062},
    eprint  = {https://academic.oup.com/ej/advance-article-pdf/doi/10.1093/ej/ueae062/58426520/ueae062.pdf},
    abstract = {Almost half of all private employment in the United States is within
                businesses that do not pay corporate income tax. Instead business income
                passes through to the owners’ individual income taxes. This pass-through
                share of employment has more than tripled since the early 1980s. Using
                comprehensive, confidential administrative data, this paper highlights
                five core findings underlying this growth: (1) the rise in pass-throughs
                is pervasive across industries and states; (2) the pass-through share
                converges unconditionally across both; (3) entrants’ organizational
                choices drive 60% of the rise; (4) shifts in firm and organizational
                dynamics following the 1986 Tax Reform Act show continued effects through
                the 2000s; (5) organizational forms exhibit high persistence with little
                lifecycle variation. Our study implies that tax or regulatory policy
                changes might take decades to manifest fully.},
    sitecategory = {journal},
    siteorder    = {1},
    sitejournal  = {The Economic Journal},
    siteinfo     = {Volume 135, Issue 665, January 2025.},
    siteauthors  = {Benjamin Pugsley|https://sites.google.com/view/benjaminpugsley/},
    sitelinks    = {Published Paper|https://academic.oup.com/ej/advance-article-abstract/doi/10.1093/ej/ueae062/7705598?redirectedFrom=fulltext;
                    Working Paper|/files/Dyrda_Pugsley_emplfo.pdf;
                    Slides|/files/Dyrda_Pugsley_emplfo_slides.pdf;
                    Replication Package|https://github.com/sebastiandyrda/DyrdaPugsley_EmpLFO},
}

@article{dkrr_jedc,
    title    = {Living Arrangements and Labor Market Volatility of Young Workers},
    journal  = {Journal of Economic Dynamics and Control},
    pages    = {104958},
    year     = {2024},
    issn     = {0165-1889},
    doi      = {https://doi.org/10.1016/j.jedc.2024.104958},
    url      = {https://www.sciencedirect.com/science/article/pii/S0165188924001507},
    author   = {Dyrda, Sebastian and Kaplan, Greg and R{\'i}os-Rull, Jos{\'e}-V{\'i}ctor},
    keywords = {Business cycles, Household formation, Aggregate risk, Elasticity of labor supply},
    abstract = {Household size is countercyclical, mainly because of young people moving
                into or delaying departure from the parental home. Those living in older
                households earn less and have more volatile hours than their peers living
                alone. We pose a theory of household formation and labor choice over the
                business cycle. Young people decide where to live depending on their wage,
                taste for living within the old household, and implicit transfers
                received. Our theory accounts for the bulk of the contribution of the
                households size volatility to the volatility of the aggregate hours.
                Including people with varying living arrangements yields an implied
                aggregate, or macro, Frisch elasticity around 70 percent larger than the
                assumed micro elasticity.},
    sitecategory = {journal},
    siteorder    = {2},
    sitejournal  = {Journal of Economic Dynamics and Control},
    siteinfo     = {Volume 169, December 2024.},
    siteauthors  = {Greg Kaplan|http://gregkaplan.uchicago.edu/;
                    Jos\'e V\'ictor R\'ios Rull|http://www.sas.upenn.edu/~vr0j/},
    sitelinks    = {Published Paper|https://www.sciencedirect.com/science/article/pii/S0165188924001507;
                    Working Paper|/files/dkrr_jedc.pdf;
                    Slides|/files/dkrr_jedc_slides.pdf;
                    Replication Package|https://github.com/sebastiandyrda/DKRR_JEDC},
}

@article{DHSTaxingMNEs2024,
    title    = {A macroeconomic perspective on taxing multinational enterprises},
    journal  = {Journal of International Economics},
    volume   = {152},
    pages    = {104022},
    year     = {2024},
    issn     = {0022-1996},
    doi      = {https://doi.org/10.1016/j.jinteco.2024.104022},
    url      = {https://www.sciencedirect.com/science/article/pii/S0022199624001491},
    author   = {Dyrda, Sebastian and Hong, Guangbin and Steinberg, Joseph B.},
    keywords = {Multinational enterprise, Transfer pricing, Profit shifting, Base erosion, Intangible capital, Corporate tax},
    abstract = {We develop a general-equilibrium model to study the macroeconomic
                consequences of international profit shifting by multinational enterprises
                (MNEs). In our model, MNEs shift profits by exploiting intangible capital
                transfer pricing rules, which makes intangible investment more attractive
                and leads to higher output at home and abroad. We use the model to
                quantify the effects of two reforms proposed by the OECD: (i) reallocating
                MNEs’ profit tax bases to the countries where they sell their products;
                and (ii) a minimum global corporate income tax. Both reforms would reduce
                profit shifting substantially, but (i) would reduce global output whereas
                (ii) would have little macroeconomic impact. The reforms’ distributional
                implications would also be important. In high-tax countries, tax revenues
                would increase more than output declines, raising gross national income
                and enabling redistribution that could offset lower wages. In contrast,
                output and tax revenues would both drop in low-tax countries,
                significantly reducing national income.},
    sitecategory = {journal},
    siteorder    = {3},
    sitetitle    = {A Macroeconomic Perspective on Taxing Multinational Enterprises},
    sitejournal  = {Journal of International Economics},
    siteinfo     = {Volume 152, November 2024.},
    siteauthors  = {Guangbin Hong|https://www.guangbinhong.com;
                    Joseph B. Steinberg|https://www.joesteinberg.com/},
    sitelinks    = {Published Paper|https://www.sciencedirect.com/science/article/pii/S0022199624001491;
                    Working Paper|/files/DyrdaHongSteinberg_TaxingMNEs.pdf;
                    Slides|/files/DyrdaHongSteinberg_TaxingMNEs_slides.pdf;
                    Short Slides|/files/DHS_slides_short.pdf;
                    Replication Package|https://data.mendeley.com/datasets/wsy7x9fgxz/1;
                    VoxEU Summary|https://cepr.org/voxeu/columns/macroeconomic-consequences-reducing-international-profit-shifting},
}

@article{DHS_OptTax_JME,
    title    = {Optimal taxation of multinational enterprises: A Ramsey approach},
    journal  = {Journal of Monetary Economics},
    volume   = {141},
    pages    = {74-97},
    year     = {2024},
    issn     = {0304-3932},
    doi      = {https://doi.org/10.1016/j.jmoneco.2023.10.003},
    url      = {https://www.sciencedirect.com/science/article/pii/S0304393223001186},
    author   = {Dyrda, Sebastian and Hong, Guangbin and Steinberg, Joseph B.},
    keywords = {Multinational enterprise, Intangible capital, Profit shifting, Corporate taxation, Optimal policy, Ramsey problem},
    abstract = {What is the optimal design of the international corporate tax system? We
                revisit this classic question in a multi-country general equilibrium model
                that incorporates three key features of the modern globalized economy:
                multinational production; intangible capital; and international profit
                shifting. Our model’s competitive equilibrium is inefficient due to an
                externality that arises from international spillovers in intangible
                investment. In the absence of profit shifting, there is little, if
                anything, a Ramsey planner can do with corporate income taxes to improve
                the allocation of intangible investment across countries. However, profit
                shifting allows the planner to use corporate income taxes to internalize
                the externality and achieve an efficient allocation of intangible
                investment. To quantitatively investigate the properties of the Ramsey
                planner’s optimal policy in a more realistic setting, we extend our model
                to an environment with firm heterogeneity and selection into multinational
                production. Without spillovers, it would be optimal to shut down profit
                shifting as much as possible. With spillovers, it would be optimal to
                allow MNEs to continue to shift profits, and if the planner is restricted
                to Pareto-improving policies, it would be optimal to allow even more
                profit shifting than under the status quo.},
    sitecategory = {journal},
    siteorder    = {4},
    sitetitle    = {Optimal Taxation of Multinational Enterprises: A Ramsey Approach},
    sitejournal  = {Journal of Monetary Economics},
    siteinfo     = {Volume 141, January 2024.},
    siteauthors  = {Guangbin Hong|https://www.guangbinhong.com;
                    Joseph B. Steinberg|https://www.joesteinberg.com/},
    sitelinks    = {Published Paper|https://www.sciencedirect.com/science/article/abs/pii/S0304393223001186;
                    Working Paper|/files/DyrdaHongSteinberg_JME.pdf;
                    Slides|/files/DHS_opttax_slides.pdf},
}

@article{DyrdaPedroniRestud,
    author  = {Dyrda, Sebastian and Pedroni, Marcelo},
    title   = "{Optimal Fiscal Policy in a Model with Uninsurable Idiosyncratic Income Risk}",
    journal = {The Review of Economic Studies},
    volume  = {90},
    number  = {2},
    pages   = {744-780},
    year    = {2022},
    month   = {06},
    issn    = {0034-6527},
    doi     = {10.1093/restud/rdac031},
    url     = {https://doi.org/10.1093/restud/rdac031},
    eprint  = {https://academic.oup.com/restud/article-pdf/90/2/744/49435160/rdac031.pdf},
    abstract = {We study optimal fiscal policy in a standard incomplete-markets model with
                uninsurable idiosyncratic income risk, where a Ramsey planner chooses
                time-varying paths of proportional capital and labor income taxes,
                lump-sum transfers (or taxes), and government debt. We find that: (1)
                short-run capital income taxes are effective in providing redistribution
                since the tax base is relatively unequal and inelastic; (2) an increasing
                pattern of labor income taxes over time mitigates intertemporal
                distortions from capital income taxes; (3) the optimal policy increases
                overall transfers, calibrated initially to the US welfare system, by
                roughly 50 percent; (4) two-thirds of the welfare gains come from
                redistribution and the remaining third come mostly from insurance; and (5)
                redistribution also leads to a more efficient allocation of labor via
                wealth effects on labor supply—lower productivity households can afford to
                work relatively less.},
    sitecategory = {journal},
    siteorder    = {5},
    sitejournal  = {The Review of Economic Studies},
    siteinfo     = {Volume 90, Issue 2, March 2023.},
    siteauthors  = {Marcelo Pedroni|http://sites.google.com/site/marcelozouainpedroni/},
    sitelinks    = {Published Paper|https://doi.org/10.1093/restud/rdac031;
                    Working Paper|/files/Dyrda_Pedroni_final.pdf;
                    Online Appendix|/files/Dyrda_Pedroni_2022_Appendix.pdf;
                    Slides|/files/Dyrda_Pedroni_NBER_slides.pdf;
                    Replication Package|https://zenodo.org/record/6462485#.ZAoP_XbMKbg},
}

@article{DYRDA2019131,
    title    = {Discussion of ``Taxation and The Life Cycle of Firms'' by Erosa and Gonz{\'a}lez},
    journal  = {Journal of Monetary Economics},
    volume   = {105},
    pages    = {131-134},
    year     = {2019},
    issn     = {0304-3932},
    doi      = {https://doi.org/10.1016/j.jmoneco.2019.04.013},
    url      = {https://www.sciencedirect.com/science/article/pii/S0304393219300790},
    author   = {Dyrda, Sebastian},
    keywords = {Firm dynamics, Taxation, Firm heterogeneity, Pass-through businesses},
    abstract = {“Taxation and The Life Cycle of Firms” by Erosa and González provides a
                coherent framework to study the effects of different forms of taxing
                capital income on the life cycle of firms. In the quantitative part, the
                paper evaluates macroeconomic effects of eliminating the corporate income
                tax and replacing it with the uniform tax on all other forms of capital
                income. In this discussion I raise two issues. First, I point to the
                limitations of the modelling approach, which focuses only on entities
                subject to the corporate income tax. Second, I discuss recent evidence
                from firm-level data suggesting that privately-held firms and
                publicly-traded firms differ substantially, which is contrary to the
                implicit assumption made in the paper.},
    siteslug     = {discussion-taxation-and-the-life-cycle-of-firms},
    sitecategory = {journal},
    siteorder    = {6},
    sitetitle    = {Discussion of 'Taxation and the Life-Cycle of Firms' by Erosa and Gonzalez},
    sitejournal  = {Journal of Monetary Economics},
    siteinfo     = {Volume 105, August 2019.},
    sitelinks    = {Published Paper|https://www.sciencedirect.com/science/article/abs/pii/S0304393219300790;
                    Working Paper|/files/Dyrda_JME_comment.pdf},
}


